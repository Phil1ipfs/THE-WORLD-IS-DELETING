local function lerp(a, b, t)
	return a + (b - a) * t
end
local function blendValue(a, b, t)
	if type(a) == "number" then
		return lerp(a, b, t)
	elseif type(a) == "table" then
		local out = {}
		for key, value in a do
			out[key] = blendValue(value, b[key], t)
		end
		return out
	end
	return if t < 0.5 then a else b
end
-- Pure blend of two sky profiles; used for smooth realm-to-realm transitions.
function Config.blendSky(a, b, t)
	return blendValue(a, b, math.clamp(t, 0, 1))
end
